{
  "version": 6,
  "configurePresets": [
    {
      "name": "i686",
      "displayName": "32-bit, llvm-mingw (the only supported toolchain)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "toolchainFile": "${sourceDir}/cmake/i686-llvm-mingw.cmake",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo" }
    }
  ],
  "buildPresets": [ { "name": "i686", "configurePreset": "i686" } ]
}
