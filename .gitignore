/build/
/build-*/
/out/
/cmake-build-*/
CMakeCache.txt
CMakeFiles/
*.obj
*.o
*.lib
*.exp
*.pdb
*.ilk
*.idb
*.dll
*.exe
compile_commands.json

# MSVC / Visual Studio
.vs/
*.user
*.suo
*.vcxproj.user
/Debug/
/Release/
/x64/
/Win32/

# ---------------------------------------------------------------------------
# Editors, OS, Python
# ---------------------------------------------------------------------------
.idea/
.vscode/
*.swp
*~
Thumbs.db
Desktop.ini
.DS_Store
__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/

# Images: screenshots for the launcher and the top-level README only, in
# docs/images/ (docs/LICENSING.md section 3). Captures made for analysis stay
# in scratch folders; this keeps one from being committed by accident.
*.png
*.jpg
*.jpeg
*.gif
*.bmp
*.webp
!docs/images/
!docs/images/**

# Notes shared privately with us that must not be published yet: kept beside
# docs/ on the owner's machine and moved into docs/ when their author agrees.
docs/gitIgnored/

# Run logs a harness or a build writes at the checkout's root (bof3x.log in a
# launcher copy L/, cmake_*.log, the self-tests' st*.log): commit 3d83467a
# took 24 of them by `git add -A` before a validation run.
/*.log
/L/
