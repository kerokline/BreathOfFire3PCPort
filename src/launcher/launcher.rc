    PUSHBUTTON      "", 1326, 108, 129, 56, 14
    PUSHBUTTON      "", 1346, 170, 129, 84, 14
    PUSHBUTTON      "", 1366, 257, 129, 84, 14
    LTEXT           "Triangle", -1, 7, 148, 40, 9
    PUSHBUTTON      "", 1307, 49, 146, 56, 14
    PUSHBUTTON      "", 1327, 108, 146, 56, 14
    PUSHBUTTON      "", 1347, 170, 146, 84, 14
    PUSHBUTTON      "", 1367, 257, 146, 84, 14
