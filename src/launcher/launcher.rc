#include <windows.h>
#include "launcher/resource.h"

// The version block (src/version.rc), shared with the DLL and, through
// tools/make_exe.py, the game executable.
#define BOF3X_RC_DESCRIPTION "bof3x launcher - Breath of Fire III PC"
#define BOF3X_RC_FILENAME    "bof3x-launcher.exe"
#define BOF3X_RC_FILETYPE    VFT_APP
#include "version.rc"

// Common Controls 6 (themed dialog) and per-monitor-unaware DPI scaling, so the
// dialog is neither Windows 95 grey nor bitmap-blurred on a high-DPI desktop.
1 RT_MANIFEST "launcher/launcher.manifest"

// The icon: ours, bold white "III" in Palatino on black (tools/make_brand_icon.py,
// the owner's choice of 2026-10-15) - the first icon resource, which Explorer shows.
IDI_BOF3X ICON "../../data/icon/bof3x.ico"

// The launcher's window (docs/launcher-settings.md section 2a). Two faces: the
// title page - the picture (IDR_BACKGROUND), the banner and these four buttons -
// and Configure, the six tabs and Back over the sub-page the tab shows. The
// window is sized in pixels, a whole multiple of the picture's 640 x 480, and
// config_dialog.cpp's Layout places every control here; the coordinates below
// are placeholders. The caption is what tools/launcher_host finds it by.
IDD_CONFIG DIALOGEX 0, 0, 366, 274
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX | WS_CLIPCHILDREN
EXSTYLE WS_EX_CONTROLPARENT
CAPTION "Breath of Fire III - bof3x"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    DEFPUSHBUTTON   "&Play", IDOK, 0, 0, 50, 14, WS_GROUP
    PUSHBUTTON      "&Configure", IDC_CONFIGURE, 0, 0, 50, 14
    PUSHBUTTON      "&Jukebox", IDC_MUSICPLAYER, 0, 0, 50, 14
    PUSHBUTTON      "E&xit", IDCANCEL, 0, 0, 50, 14

    // The tabs, IDC_TAB0 + page (resource.h): push-like radio buttons, so the
    // page shown stays pressed.
    AUTORADIOBUTTON "Settings", 1022, 0, 0, 50, 14, BS_PUSHLIKE | WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "Controls", 1023, 0, 0, 50, 14, BS_PUSHLIKE
    AUTORADIOBUTTON "Music", 1024, 0, 0, 50, 14, BS_PUSHLIKE
    AUTORADIOBUTTON "Game Options", 1025, 0, 0, 50, 14, BS_PUSHLIKE
    AUTORADIOBUTTON "Mods", 1026, 0, 0, 50, 14, BS_PUSHLIKE
    AUTORADIOBUTTON "Data", 1027, 0, 0, 50, 14, BS_PUSHLIKE
    PUSHBUTTON      "Back", IDC_BACK, 0, 0, 50, 14, WS_GROUP | WS_TABSTOP

    // A tab's sub-tabs, IDC_SUB0 + place, labelled by the tab (config_dialog.cpp
    // kSubPages): shown only over a tab with more than one sub-page.
    AUTORADIOBUTTON "", 1032, 0, 0, 50, 14, BS_PUSHLIKE | WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "", 1033, 0, 0, 50, 14, BS_PUSHLIKE
    AUTORADIOBUTTON "", 1034, 0, 0, 50, 14, BS_PUSHLIKE
END

// The title page's picture: a screenshot on the terms of docs/LICENSING.md
// section 3 (docs/images/ only, an asset of the launcher's own pages).
IDR_BACKGROUND RCDATA "../../docs/images/launcherBackground.png"

IDD_PAGE_SETTINGS DIALOGEX 0, 0, 300, 176
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD
EXSTYLE WS_EX_CONTROLPARENT
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    GROUPBOX        "Settings", -1, 0, 0, 296, 162

    LTEXT           "&Language:", -1, 9, 17, 62, 9
    COMBOBOX        IDC_LANGUAGE, 77, 15, 186, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "", IDC_LANGNOTE, 77, 30, 186, 9

    // The row above the text (docs/mods.md 5): none, a reading-row mod, another
    // held language. Owner-drawn so an entry this install cannot play is greyed.
    // Hidden, with its label, unless Mods, Extras' toggle is on (ruby_ui=1; the
    // owner's call, 2026-10-22) - display only, ruby= is kept and played either way.
    LTEXT           "Row &above the text:", IDC_RUBYLABEL, 9, 42, 67, 9
    COMBOBOX        IDC_RUBY, 77, 40, 186, 80, CBS_DROPDOWNLIST | CBS_OWNERDRAWFIXED | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP

    LTEXT           "&Look:", -1, 9, 58, 62, 9
    COMBOBOX        IDC_FILTER, 77, 56, 132, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "&Options...", IDC_LOOKOPTIONS, 213, 55, 50, 14

    LTEXT           "&Display:", -1, 9, 74, 62, 9
    COMBOBOX        IDC_DISPLAY, 77, 72, 186, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    // No Renderer box since 2026-10-24 (issue 124): both of BOF3.CFG's renderer
    // values take the Direct3D 11 path (DIV-0031). renderer= in bof3x.ini is still
    // read and written for the all-original side (config.cpp).

    // DIV-0041: off, 16:9 or 21:9 (wide= 0, 1, 2; docs/ultrawide-frame.md)
    LTEXT           "&Widescreen:", -1, 9, 90, 62, 9
    COMBOBOX        IDC_WIDE, 77, 88, 186, 60, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    AUTOCHECKBOX    "&Integer scaling (2x, 3x, 4x ...)", IDC_SNAP, 7, 105, 268, 10
    AUTOCHECKBOX    "&Keep the game running when its window is not active", IDC_BACKGROUND, 7, 119, 268, 10

    AUTOCHECKBOX    "&Show this window at start", IDC_SHOW, 7, 133, 200, 10
    LTEXT           "Off: the game starts immediately.\nTo show this window again, start bof3x-launcher --config.",
                    -1, 19, 144, 272, 16

    // Shown when the preset (the Preset sub-page) sets a setting of this page,
    // which is then grey (config_dialog.cpp PresetRefresh).
    LTEXT           "", IDC_PRESETGREY, 0, 165, 296, 9
END

// The preset (launcher/config.h, docs/launcher-settings.md "preset="): the
// Settings tab's second sub-page. The box, the preset's sentence, and a
// read-only list of what the preset changes for the language selected on this
// install: the changes it turns off, those this build cannot, those it cannot
// on this install, and those to turn on yourself.
IDD_PAGE_PRESET DIALOGEX 0, 0, 350, 168
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD
EXSTYLE WS_EX_CONTROLPARENT
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    GROUPBOX        "Preset", -1, 0, 0, 346, 166
    LTEXT           "&Preset:", -1, 9, 17, 48, 9
    COMBOBOX        IDC_PRESET, 59, 15, 236, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "", IDC_PRESETNOTE, 9, 32, 330, 18
    LTEXT           "What the preset changes when the game starts. Your settings in bof3x.ini do not change.",
                    -1, 9, 52, 330, 9
    EDITTEXT        IDC_PRESETLIST, 7, 63, 332, 98, ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL | WS_TABSTOP
END

// DIV-0050 (docs/controls.md section 4.2): the physical bindings, on two
// sub-pages. Each row is one PlayStation input; a cell is a button showing its
// binding - click it (or press cross on it) and the capture dialog takes the
// next key or pad input. The cells' ids are base + row (resource.h).
IDD_PAGE_CONTROLS DIALOGEX 0, 0, 350, 168
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD
