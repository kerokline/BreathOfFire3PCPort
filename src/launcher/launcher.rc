#include <windows.h>
#include "launcher/resource.h"

// Common Controls 6 (themed dialog) and per-monitor-unaware DPI scaling, so the
// dialog is neither Windows 95 grey nor bitmap-blurred on a high-DPI desktop.
1 RT_MANIFEST "launcher/launcher.manifest"

IDD_CONFIG DIALOGEX 0, 0, 560, 309
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Breath of Fire III - bof3x"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    GROUPBOX        "Settings", -1, 7, 7, 276, 148

    LTEXT           "&Language:", -1, 16, 24, 62, 9
    COMBOBOX        IDC_LANGUAGE, 84, 22, 186, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "", IDC_LANGNOTE, 84, 37, 186, 9

    LTEXT           "&Look:", -1, 16, 52, 62, 9
    COMBOBOX        IDC_FILTER, 84, 50, 132, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "&Options...", IDC_LOOKOPTIONS, 220, 49, 50, 14

    LTEXT           "&Display:", -1, 16, 70, 62, 9
    COMBOBOX        IDC_DISPLAY, 84, 68, 186, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    LTEXT           "Re&nderer:", -1, 16, 88, 62, 9
    COMBOBOX        IDC_RENDERER, 84, 86, 186, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Only Capcom's set-up reads it; bof3x always draws with Direct3D 11.",
                    -1, 84, 101, 196, 9

    AUTOCHECKBOX    "&Keep running when the window is not in front", IDC_BACKGROUND, 14, 116, 250, 10
    // DIV-0041: off, 16:9 or 21:9 (wide= 0, 1, 2; docs/ultrawide-frame.md)
    LTEXT           "&Widescreen:", -1, 16, 131, 62, 9
    COMBOBOX        IDC_WIDE, 84, 128, 186, 60, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    AUTOCHECKBOX    "S&nap the picture to whole multiples of its size", IDC_SNAP, 14, 144, 268, 10
    LTEXT           "Ticked, the window resizes in whole steps; unticked, the picture stretches to the window's height.",
                    -1, 26, 156, 256, 9

    // DIV-0087: the music source and the importer's cache (docs/music-seq-engine.md)
    GROUPBOX        "Music", -1, 7, 172, 276, 56
    LTEXT           "&Music:", -1, 16, 186, 62, 9
    COMBOBOX        IDC_MUSIC, 84, 184, 186, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "C&ache folder:", -1, 16, 203, 62, 9
    EDITTEXT        IDC_CACHE, 84, 201, 132, 13, ES_AUTOHSCROLL | WS_TABSTOP
    PUSHBUTTON      "&Browse...", IDC_CACHEBROWSE, 220, 200, 50, 14
    LTEXT           "", IDC_CACHENOTE, 84, 216, 196, 9

    // The three suites (docs/launcher-suites.md, recipes/suites.toml): each the PlayStation's
    // version of a set of differences or the PSP's. Suite i's ids are 1040 + 10 i plus: 0 the
    // label, 1 the PlayStation radio, 2 the PSP radio, 3..6 the member lines, 7 the reason
    // (resource.h). They replaced the PSP extras boxes on 2026-10-12. The data suite has two
    // more member lines, 8 and 9 (its code members, DIV-0108), its reason three lines high.
    GROUPBOX        "Versions: the PlayStation's or the PSP's", IDC_SUITEGROUP, 290, 7, 263, 246
    LTEXT           "", IDC_SUITENOTE, 298, 19, 248, 18
    LTEXT           "", 1040, 298, 41, 40, 9
    AUTORADIOBUTTON "PlayStation", 1041, 340, 40, 104, 10, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "PSP", 1042, 446, 40, 104, 10, WS_TABSTOP
    LTEXT           "", 1043, 306, 52, 118, 9, WS_GROUP
    LTEXT           "", 1044, 428, 52, 118, 9
    LTEXT           "", 1045, 306, 61, 118, 9
    LTEXT           "", 1046, 428, 61, 118, 9
    LTEXT           "", 1047, 306, 71, 244, 36
    LTEXT           "", 1050, 298, 112, 40, 9
    AUTORADIOBUTTON "PlayStation", 1051, 340, 111, 104, 10, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "PSP", 1052, 446, 111, 104, 10, WS_TABSTOP
    LTEXT           "", 1053, 306, 123, 118, 9, WS_GROUP
    LTEXT           "", 1054, 428, 123, 118, 9
    LTEXT           "", 1055, 306, 132, 118, 9
    LTEXT           "", 1056, 428, 132, 118, 9
    LTEXT           "", 1057, 306, 142, 244, 36
    LTEXT           "", 1060, 298, 183, 40, 9
    AUTORADIOBUTTON "PlayStation", 1061, 340, 182, 104, 10, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "PSP", 1062, 446, 182, 104, 10, WS_TABSTOP
    LTEXT           "", 1063, 306, 194, 118, 9, WS_GROUP
    LTEXT           "", 1064, 428, 194, 118, 9
    LTEXT           "", 1065, 306, 203, 118, 9
    LTEXT           "", 1066, 428, 203, 118, 9
    LTEXT           "", 1068, 306, 212, 118, 9
    LTEXT           "", 1069, 428, 212, 118, 9
    LTEXT           "", 1067, 306, 222, 244, 27

    AUTOCHECKBOX    "&Show this window every time", IDC_SHOW, 14, 261, 200, 10, WS_GROUP | WS_TABSTOP
    LTEXT           "Unticked, the game starts straight away. Run bof3x-launcher --config to bring it back.",
                    -1, 14, 273, 262, 9

    PUSHBUTTON      "&Cheats...", IDC_CHEATS, 7, 289, 52, 14
    PUSHBUTTON      "C&ontrols...", IDC_CONTROLS, 63, 289, 52, 14
    PUSHBUTTON      "&Jukebox...", IDC_MUSICPLAYER, 119, 289, 48, 14
    PUSHBUTTON      "So&urces...", IDC_SOURCES, 171, 289, 52, 14
    DEFPUSHBUTTON   "&Play", IDOK, 443, 289, 52, 14
    PUSHBUTTON      "E&xit", IDCANCEL, 501, 289, 52, 14
END

// DIV-0045 / DIV-0046: the cheats (docs/cheats.md).
IDD_CHEATS DIALOGEX 0, 0, 300, 150
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Cheats"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    GROUPBOX        "Battle rewards", -1, 7, 7, 286, 64
    LTEXT           "EXP won, times", -1, 14, 21, 90, 9
    CONTROL         "", IDC_CH_EXP, "msctls_trackbar32", TBS_HORZ | TBS_AUTOTICKS | WS_TABSTOP, 106, 18, 150, 14
    LTEXT           "1", IDC_CH_EXP_V, 260, 21, 30, 9
    LTEXT           "Zenny won, times", -1, 14, 37, 90, 9
    CONTROL         "", IDC_CH_ZENNY, "msctls_trackbar32", TBS_HORZ | TBS_AUTOTICKS | WS_TABSTOP, 106, 34, 150, 14
    LTEXT           "1", IDC_CH_ZENNY_V, 260, 37, 30, 9
    LTEXT           "1 is the game's own; 0 grants none at all, so no level-ups. Applied as each enemy falls.",
                    -1, 14, 54, 276, 9

    GROUPBOX        "Stealing", -1, 7, 76, 286, 46
    AUTOCHECKBOX    "&Steal always succeeds", IDC_CH_STEAL, 14, 90, 270, 10
    LTEXT           "Pilfer and Steal take the enemy's item on the first try whenever it carries one. Enemies with nothing still have nothing.",
                    -1, 26, 102, 260, 18

    PUSHBUTTON      "&Defaults", IDC_CH_DEFAULTS, 7, 129, 52, 14
    DEFPUSHBUTTON   "OK", IDOK, 182, 129, 52, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 240, 129, 52, 14
END

// DIV-0043: the SatPixie look's parameters, the preset's names and ranges.
IDD_SATPIXIE DIALOGEX 0, 0, 300, 252
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "SatPixie CRT look - options"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    GROUPBOX        "Amounts", -1, 7, 7, 286, 96
    LTEXT           "Accumulate modulation", -1, 14, 21, 90, 9
    CONTROL         "", IDC_SP_MODULATE, "msctls_trackbar32", TBS_HORZ | TBS_AUTOTICKS | WS_TABSTOP, 106, 18, 150, 14
    LTEXT           "0.65", IDC_SP_MODULATE_V, 260, 21, 30, 9
    LTEXT           "Gamma (natural vision)", -1, 14, 37, 90, 9
    CONTROL         "", IDC_SP_GAMMA, "msctls_trackbar32", TBS_HORZ | TBS_AUTOTICKS | WS_TABSTOP, 106, 34, 150, 14
    LTEXT           "2.3", IDC_SP_GAMMA_V, 260, 37, 30, 9
    LTEXT           "Chroma strength", -1, 14, 53, 90, 9
    CONTROL         "", IDC_SP_CHROMA, "msctls_trackbar32", TBS_HORZ | TBS_AUTOTICKS | WS_TABSTOP, 106, 50, 150, 14
    LTEXT           "0.7", IDC_SP_CHROMA_V, 260, 53, 30, 9
    LTEXT           "Horizontal blur", -1, 14, 69, 90, 9
    CONTROL         "", IDC_SP_BLURX, "msctls_trackbar32", TBS_HORZ | TBS_AUTOTICKS | WS_TABSTOP, 106, 66, 150, 14
    LTEXT           "0", IDC_SP_BLURX_V, 260, 69, 30, 9
    LTEXT           "Vertical blur", -1, 14, 85, 90, 9
    CONTROL         "", IDC_SP_BLURY, "msctls_trackbar32", TBS_HORZ | TBS_AUTOTICKS | WS_TABSTOP, 106, 82, 150, 14
    LTEXT           "0", IDC_SP_BLURY_V, 260, 85, 30, 9

    GROUPBOX        "Effects", -1, 7, 108, 286, 108
    AUTOCHECKBOX    "&Natural vision (neutral colours, gamma above)", IDC_SP_NATURAL, 14, 122, 270, 10
    AUTOCHECKBOX    "&Ghosting", IDC_SP_GHOSTING, 14, 136, 130, 10
    AUTOCHECKBOX    "&Chromatic aberration", IDC_SP_CHROMAON, 150, 136, 130, 10
    AUTOCHECKBOX    "&Vignette", IDC_SP_VIGNETTE, 14, 150, 130, 10
    AUTOCHECKBOX    "Vignette shaped for &4:3 only", IDC_SP_VIG43, 150, 150, 136, 10
    AUTOCHECKBOX    "&Interference wiggle", IDC_SP_WIGGLE, 14, 164, 130, 10
    AUTOCHECKBOX    "&Rolling scanlines", IDC_SP_SCANROLL, 150, 164, 130, 10
    AUTOCHECKBOX    "&Overscan crop (trims the picture's edges)", IDC_SP_OVERSCAN, 14, 178, 270, 10
    LTEXT           "The 4:3 vignette leaves a wide picture's side bands bright; off, it covers the whole picture.", -1, 26, 209, 260, 9
    LTEXT           "Shadow &mask:", -1, 14, 196, 60, 9
    COMBOBOX        IDC_SP_MASK, 76, 194, 120, 60, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    PUSHBUTTON      "&Defaults", IDC_SP_DEFAULTS, 7, 231, 52, 14
    DEFPUSHBUTTON   "OK", IDOK, 182, 231, 52, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 240, 231, 52, 14
END

// DIV-0050 (docs/controls.md section 4.2): the physical bindings. Each row is
// one PlayStation input; a cell is a button showing its binding - click it (or
// press cross on it) and the capture dialog takes the next key or pad input.
IDD_CONTROLS DIALOGEX 0, 0, 410, 334
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Controls"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    GROUPBOX        "Bindings", -1, 7, 7, 396, 272
    LTEXT           "Keyboard", -1, 60, 20, 66, 9
    LTEXT           "also", -1, 130, 20, 66, 9
    LTEXT           "Pad", -1, 206, 20, 96, 9
    LTEXT           "also", -1, 306, 20, 96, 9
    LTEXT           "Up", -1, 14, 36, 44, 9
    PUSHBUTTON      "", 1300, 60, 34, 66, 14
    PUSHBUTTON      "", 1320, 130, 34, 66, 14
    PUSHBUTTON      "", 1340, 206, 34, 96, 14
    PUSHBUTTON      "", 1360, 306, 34, 96, 14
    LTEXT           "Down", -1, 14, 53, 44, 9
    PUSHBUTTON      "", 1301, 60, 51, 66, 14
    PUSHBUTTON      "", 1321, 130, 51, 66, 14
    PUSHBUTTON      "", 1341, 206, 51, 96, 14
    PUSHBUTTON      "", 1361, 306, 51, 96, 14
    LTEXT           "Left", -1, 14, 70, 44, 9
    PUSHBUTTON      "", 1302, 60, 68, 66, 14
    PUSHBUTTON      "", 1322, 130, 68, 66, 14
    PUSHBUTTON      "", 1342, 206, 68, 96, 14
    PUSHBUTTON      "", 1362, 306, 68, 96, 14
    LTEXT           "Right", -1, 14, 87, 44, 9
    PUSHBUTTON      "", 1303, 60, 85, 66, 14
    PUSHBUTTON      "", 1323, 130, 85, 66, 14
    PUSHBUTTON      "", 1343, 206, 85, 96, 14
    PUSHBUTTON      "", 1363, 306, 85, 96, 14
    LTEXT           "Cross", -1, 14, 104, 44, 9
    PUSHBUTTON      "", 1304, 60, 102, 66, 14
    PUSHBUTTON      "", 1324, 130, 102, 66, 14
    PUSHBUTTON      "", 1344, 206, 102, 96, 14
    PUSHBUTTON      "", 1364, 306, 102, 96, 14
    LTEXT           "Circle", -1, 14, 121, 44, 9
    PUSHBUTTON      "", 1305, 60, 119, 66, 14
    PUSHBUTTON      "", 1325, 130, 119, 66, 14
    PUSHBUTTON      "", 1345, 206, 119, 96, 14
    PUSHBUTTON      "", 1365, 306, 119, 96, 14
    LTEXT           "Square", -1, 14, 138, 44, 9
    PUSHBUTTON      "", 1306, 60, 136, 66, 14
    PUSHBUTTON      "", 1326, 130, 136, 66, 14
    PUSHBUTTON      "", 1346, 206, 136, 96, 14
    PUSHBUTTON      "", 1366, 306, 136, 96, 14
    LTEXT           "Triangle", -1, 14, 155, 44, 9
    PUSHBUTTON      "", 1307, 60, 153, 66, 14
    PUSHBUTTON      "", 1327, 130, 153, 66, 14
    PUSHBUTTON      "", 1347, 206, 153, 96, 14
    PUSHBUTTON      "", 1367, 306, 153, 96, 14
    LTEXT           "L1", -1, 14, 172, 44, 9
    PUSHBUTTON      "", 1308, 60, 170, 66, 14
    PUSHBUTTON      "", 1328, 130, 170, 66, 14
    PUSHBUTTON      "", 1348, 206, 170, 96, 14
    PUSHBUTTON      "", 1368, 306, 170, 96, 14
    LTEXT           "L2", -1, 14, 189, 44, 9
    PUSHBUTTON      "", 1309, 60, 187, 66, 14
    PUSHBUTTON      "", 1329, 130, 187, 66, 14
    PUSHBUTTON      "", 1349, 206, 187, 96, 14
    PUSHBUTTON      "", 1369, 306, 187, 96, 14
    LTEXT           "R1", -1, 14, 206, 44, 9
    PUSHBUTTON      "", 1310, 60, 204, 66, 14
    PUSHBUTTON      "", 1330, 130, 204, 66, 14
    PUSHBUTTON      "", 1350, 206, 204, 96, 14
    PUSHBUTTON      "", 1370, 306, 204, 96, 14
    LTEXT           "R2", -1, 14, 223, 44, 9
    PUSHBUTTON      "", 1311, 60, 221, 66, 14
    PUSHBUTTON      "", 1331, 130, 221, 66, 14
    PUSHBUTTON      "", 1351, 206, 221, 96, 14
    PUSHBUTTON      "", 1371, 306, 221, 96, 14
    LTEXT           "Start", -1, 14, 240, 44, 9
    PUSHBUTTON      "", 1312, 60, 238, 66, 14
    PUSHBUTTON      "", 1332, 130, 238, 66, 14
    PUSHBUTTON      "", 1352, 206, 238, 96, 14
    PUSHBUTTON      "", 1372, 306, 238, 96, 14
    LTEXT           "Select", -1, 14, 257, 44, 9
    PUSHBUTTON      "", 1313, 60, 255, 66, 14
    PUSHBUTTON      "", 1333, 130, 255, 66, 14
    PUSHBUTTON      "", 1353, 206, 255, 96, 14
    PUSHBUTTON      "", 1373, 306, 255, 96, 14

    LTEXT           "Face &buttons:", -1, 14, 284, 60, 9
    COMBOBOX        IDC_CT_LAYOUT, 76, 282, 200, 60, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Click a cell and press a key or a pad input; Escape cancels. The keypad's diagonals (7 9 1 3) stay bound unless a cell takes them.", -1, 14, 300, 390, 9

    PUSHBUTTON      "&Defaults", IDC_CT_DEFAULTS, 7, 316, 52, 14
    DEFPUSHBUTTON   "OK", IDOK, 292, 316, 52, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 350, 316, 52, 14
END

// The capture over a Controls cell (DIV-0050): the next key or pad input.
IDD_CAPTURE DIALOGEX 0, 0, 250, 74
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Bind"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "", IDC_CP_PROMPT, 14, 12, 222, 22
    LTEXT           "Escape cancels. Clear empties the cell.", -1, 14, 38, 222, 9
    PUSHBUTTON      "&Clear", IDC_CP_CLEAR, 138, 53, 48, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 194, 53, 48, 14
END

// The music player (docs/music-player.md): a source greyed when the install lacks it.
IDD_MUSIC DIALOGEX 0, 0, 320, 186
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Jukebox"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    GROUPBOX        "Source", -1, 7, 7, 306, 64
    AUTORADIOBUTTON "Play&Station disc", IDC_MP_PSX, 14, 20, 90, 10, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "P&SP disc", IDC_MP_PSP, 110, 20, 90, 10
    AUTORADIOBUTTON "P&C port", IDC_MP_PC, 206, 20, 90, 10
    LTEXT           "", IDC_MP_NOTE, 14, 34, 296, 34

    LTEXT           "S&ong:", -1, 7, 80, 30, 9
    COMBOBOX        IDC_MP_SONG, 40, 78, 273, 200, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP | WS_GROUP
    LTEXT           "", IDC_MP_STATUS, 7, 98, 306, 18

    GROUPBOX        "In the game (a sound effect, not a song)", -1, 7, 118, 306, 42
    AUTOCHECKBOX    "&Battle chord as the PSP plays it (one tone)", IDC_MP_CHORD, 14, 130, 290, 10, WS_TABSTOP | WS_GROUP
    LTEXT           "", IDC_MP_CHORD_NOTE, 14, 142, 296, 16

    PUSHBUTTON      "&Play", IDC_MP_PLAY, 7, 165, 52, 14
    PUSHBUTTON      "S&top", IDC_MP_STOP, 63, 165, 52, 14
    DEFPUSHBUTTON   "Close", IDCANCEL, 261, 165, 52, 14
END

// The Sources page (docs/install-sources.md): the player's copies of the game,
// checked and built by tools/importer.py (src/launcher/sources_dialog.cpp).
IDD_SOURCES DIALOGEX 0, 0, 400, 276
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Sources - bof3x"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "", IDC_SO_INTRO, 7, 7, 386, 26
    LTEXT           "Your sources:", -1, 7, 36, 200, 9
    LISTBOX         IDC_SO_LIST, 7, 46, 330, 62, LBS_NOTIFY | LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_HSCROLL | WS_BORDER | WS_TABSTOP
    PUSHBUTTON      "&Remove", IDC_SO_REMOVE, 343, 46, 50, 14

    LTEXT           "&Add a source:", -1, 7, 114, 200, 9
    EDITTEXT        IDC_SO_PATH, 7, 124, 224, 13, ES_AUTOHSCROLL | WS_TABSTOP
    PUSHBUTTON      "&File...", IDC_SO_FILE, 235, 123, 50, 14
    PUSHBUTTON      "F&older...", IDC_SO_FOLDER, 289, 123, 50, 14
    DEFPUSHBUTTON   "A&dd", IDC_SO_ADD, 343, 123, 50, 14

    LTEXT           "", IDC_SO_FFNOTE, 7, 145, 386, 9, SS_PATHELLIPSIS
    PUSHBUTTON      "&Locate ffmpeg.exe...", IDC_SO_FFLOCATE, 231, 157, 76, 14
    PUSHBUTTON      "&Get ffmpeg (website)...", IDC_SO_FFGET, 311, 157, 82, 14

    CONTROL         "", IDC_SO_PROGRESS, "msctls_progress32", WS_BORDER, 7, 180, 386, 9
    LTEXT           "", IDC_SO_STATUS, 7, 192, 386, 9, SS_ENDELLIPSIS
    EDITTEXT        IDC_SO_LOG, 7, 204, 386, 46, ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL | WS_TABSTOP

    LTEXT           "", IDC_SO_HOME, 7, 258, 270, 9, SS_PATHELLIPSIS
    PUSHBUTTON      "&Build the install", IDC_SO_BUILD, 281, 255, 64, 14
    PUSHBUTTON      "&Close", IDCANCEL, 349, 255, 44, 14
END
