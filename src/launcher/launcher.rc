// The Mods tab (docs/mods.md): the player's mods, each a .zip of data files
// checked, unpacked and built by tools/mods.py, run as the Sources page runs the
// importer (src/launcher/sources_dialog.cpp ModsPageProc). The list is
// owner-drawn: a mod the install cannot play is greyed, with its reason.
// Since 2026-10-22 the first of the tab's two sub-pages (Data, Extras), so it
// sits under the sub-tabs: 176 high as the Controls tab's second page, to fit
// the 640 x 480 window there.
IDD_PAGE_MODS DIALOGEX 0, 0, 340, 176
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD
EXSTYLE WS_EX_CONTROLPARENT
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    GROUPBOX        "Mods", -1, 0, 0, 336, 174
    LTEXT           "A mod is a .zip file with a mod.toml and data files. A mod cannot contain programs. The launcher checks each mod, then builds it with your copies of the game.",
                    -1, 9, 12, 320, 27
    LISTBOX         IDC_MOD_LIST, 9, 42, 320, 44, LBS_NOTIFY | LBS_NOINTEGRALHEIGHT | LBS_OWNERDRAWFIXED | LBS_HASSTRINGS | WS_VSCROLL | WS_BORDER | WS_TABSTOP
    PUSHBUTTON      "&Remove", IDC_MOD_REMOVE, 279, 89, 50, 14

    LTEXT           "Add a mod (.zip):", -1, 9, 105, 200, 9
    EDITTEXT        IDC_MOD_PATH, 9, 115, 210, 13, ES_AUTOHSCROLL | WS_TABSTOP
    PUSHBUTTON      "&Browse...", IDC_MOD_BROWSE, 223, 114, 50, 14
    PUSHBUTTON      "A&dd", IDC_MOD_ADD, 279, 114, 50, 14

    LTEXT           "", IDC_MOD_STATUS, 9, 131, 320, 9, SS_ENDELLIPSIS
    EDITTEXT        IDC_MOD_LOG, 9, 141, 320, 29, ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL | WS_TABSTOP
END

// The Mods tab's second sub-page, Extras - the Mods tab's sub-row is Data (the
// page above) and Extras (the owner's call, 2026-10-22): the home for the
// launcher's extras, reserving the slot on the top row. Today one toggle,
// ruby_ui= in bof3x.ini: whether Settings shows the Row above the text box.
// Display only. And text_speed=, the faster text (DIV-0158); unlearned_blue=,
// an enemy's skill the party can still learn named in blue (DIV-0179).
IDD_PAGE_EXTRA DIALOGEX 0, 0, 340, 132
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD
EXSTYLE WS_EX_CONTROLPARENT
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    GROUPBOX        "Extras", -1, 0, 0, 336, 130
    AUTOCHECKBOX    "S&how the Row above the text box on Settings (furigana or a second language)",
                    IDC_EXTRA_RUBY, 7, 14, 324, 10
    LTEXT           "The row is a second line of text above the game text: furigana from a mod, or a different language of this install. When you add a furigana mod, this box turns on. Off: only the box is hidden. The game still shows the row that you selected.",
                    IDC_EXTRA_RUBYNOTE, 19, 27, 312, 32
    AUTOCHECKBOX    "&Faster text: Msg Speed Med. runs at Fast speed, and Fast shows each page at once",
                    IDC_EXTRA_TEXTSPEED, 7, 63, 324, 10
    LTEXT           "For text boxes outside battle. Battle messages already show at once. The pauses in the text stay. Slow does not change.",
                    IDC_EXTRA_TEXTNOTE, 19, 76, 312, 18
    AUTOCHECKBOX    "Show the name of a skill that you can &learn in blue",
                    IDC_EXTRA_LEARNBLUE, 7, 97, 324, 10
    LTEXT           "In battle only. When an enemy uses a skill that the party can learn and does not know, the name of the skill shows in blue. Menus do not change.",
                    IDC_EXTRA_LEARNNOTE, 19, 110, 312, 18
END

