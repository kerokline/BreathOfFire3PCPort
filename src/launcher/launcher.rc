#include <windows.h>

// The launchers' resources on Windows: bof3x-launcher.exe (the drawn
// launcher, src/launcher/ui) and bof3x-launcher-dev.exe (launcher.cpp). Since
// stage P6 of docs/launcher-portable.md (2026-11-20) the Win32 dialogs and
// their templates are gone; what a player's program needs is kept: the
// version block, the manifest and the icon.

// The version block (src/version.rc), shared with the DLL and, through
// tools/make_exe.py, the game executable.
#define BOF3X_RC_DESCRIPTION "bof3x launcher - Breath of Fire III PC"
#define BOF3X_RC_FILENAME    "bof3x-launcher.exe"
#define BOF3X_RC_FILETYPE    VFT_APP
#include "version.rc"

// The manifest (launcher.manifest): the program's identity and asInvoker. No
// DPI line - SDL declares the window per-monitor DPI aware itself when its
// video starts (SDL_windowsvideo.c WIN_InitDPIAwareness), and a manifest's DPI
// line would stop that call - and no Common Controls 6: no common control is
// left in either launcher.
1 RT_MANIFEST "launcher/launcher.manifest"

// The icon: ours, bold white "III" in Palatino on black (tools/make_brand_icon.py,
// the owner's choice of 2026-10-15) - the first icon resource, which Explorer
// shows, and which SDL gives the launcher's window (SDL_RegisterApp takes the
// first icon of the program).
1 ICON "../../data/icon/bof3x.ico"
