    LTEXT           "", 1064, 138, 25, 118, 9
    LTEXT           "", 1065, 16, 34, 118, 9
    LTEXT           "", 1066, 138, 34, 118, 9
    LTEXT           "", 1068, 16, 43, 118, 9
    LTEXT           "", 1069, 138, 43, 118, 9
    LTEXT           "", 1067, 16, 53, 244, 45
