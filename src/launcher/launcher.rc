// DIV-0087: the music source (docs/music-seq-engine.md).
IDD_PAGE_MUSIC DIALOGEX 0, 0, 280, 60
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD
EXSTYLE WS_EX_CONTROLPARENT
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    GROUPBOX        "Music", -1, 0, 0, 276, 56
    LTEXT           "&Music:", -1, 9, 17, 62, 9
    COMBOBOX        IDC_MUSIC, 77, 15, 186, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "The game plays its music from this source. If this source does not have a song, the game plays that song from a different source.",
                    -1, 9, 34, 260, 18
END

// DIV-0045 / DIV-0046 / DIV-0187: the cheats (docs/cheats.md), Game Options' third sub-page.
IDD_PAGE_GAME DIALOGEX 0, 0, 290, 176
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD
EXSTYLE WS_EX_CONTROLPARENT
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    GROUPBOX        "Battle rewards", -1, 0, 0, 286, 64
    LTEXT           "EXP multiplier", -1, 7, 14, 90, 9
    CONTROL         "", IDC_CH_EXP, "msctls_trackbar32", TBS_HORZ | TBS_AUTOTICKS | WS_TABSTOP, 99, 11, 150, 14
    LTEXT           "1", IDC_CH_EXP_V, 253, 14, 30, 9
    LTEXT           "Zenny multiplier", -1, 7, 30, 90, 9
    CONTROL         "", IDC_CH_ZENNY, "msctls_trackbar32", TBS_HORZ | TBS_AUTOTICKS | WS_TABSTOP, 99, 27, 150, 14
    LTEXT           "1", IDC_CH_ZENNY_V, 253, 30, 30, 9
    LTEXT           "1 is normal. 0 gives no EXP or Zenny (no level-ups). Applies when each enemy is defeated.",
                    -1, 7, 47, 276, 9

    GROUPBOX        "Stealing", -1, 0, 69, 286, 42
    AUTOCHECKBOX    "&Steal always succeeds", IDC_CH_STEAL, 7, 81, 270, 10
    LTEXT           "Pilfer and Steal always take the enemy's item on the first try, if the enemy has an item.",
                    -1, 19, 93, 260, 18

    GROUPBOX        "Enemy information", -1, 0, 115, 286, 42
    AUTOCHECKBOX    "Show every enemy's &HP bar and stats", IDC_CH_INFO, 7, 127, 270, 10
    LTEXT           "The HP bar and the Identify stats show for every enemy, bosses too, before you defeat that kind.",
                    -1, 19, 139, 260, 18

    PUSHBUTTON      "&Defaults", IDC_CH_DEFAULTS, 0, 160, 52, 14
END

// The three suites (docs/launcher-suites.md, recipes/suites.toml): each the
// PlayStation's version of a set of differences or the PSP's, on Game
// Options' first two sub-pages. Suite i's ids are 1040 + 10 i plus: 0 the label, 1 the
// PlayStation radio, 2 the PSP radio, 3..6 the member lines, 7 the reason
// (resource.h). They replaced the PSP extras boxes on 2026-10-12. The data
// suite has two more member lines, 8 and 9 (its code members, DIV-0108), its
// reason five lines high.
IDD_PAGE_VERSIONS DIALOGEX 0, 0, 266, 178
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD
EXSTYLE WS_EX_CONTROLPARENT
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    GROUPBOX        "PlayStation or PSP version", IDC_SUITEGROUP, 0, 0, 263, 176
    LTEXT           "", IDC_SUITENOTE, 8, 12, 248, 18
    LTEXT           "", 1040, 8, 34, 40, 9
    AUTORADIOBUTTON "PlayStation", 1041, 50, 33, 104, 10, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "PSP", 1042, 156, 33, 104, 10, WS_TABSTOP
    LTEXT           "", 1043, 16, 45, 118, 9, WS_GROUP
    LTEXT           "", 1044, 138, 45, 118, 9
    LTEXT           "", 1045, 16, 54, 118, 9
    LTEXT           "", 1046, 138, 54, 118, 9
    LTEXT           "", 1047, 16, 64, 244, 36
    LTEXT           "", 1050, 8, 104, 40, 9
    AUTORADIOBUTTON "PlayStation", 1051, 50, 103, 104, 10, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "PSP", 1052, 156, 103, 104, 10, WS_TABSTOP
    LTEXT           "", 1053, 16, 115, 118, 9, WS_GROUP
    LTEXT           "", 1054, 138, 115, 118, 9
    LTEXT           "", 1055, 16, 124, 118, 9
    LTEXT           "", 1056, 138, 124, 118, 9
    LTEXT           "", 1057, 16, 134, 244, 36
END

IDD_PAGE_VERSIONS2 DIALOGEX 0, 0, 266, 106
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD
EXSTYLE WS_EX_CONTROLPARENT
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    GROUPBOX        "PlayStation or PSP version", -1, 0, 0, 263, 104
    LTEXT           "", 1060, 8, 14, 40, 9
    AUTORADIOBUTTON "PlayStation", 1061, 50, 13, 104, 10, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "PSP", 1062, 156, 13, 104, 10, WS_TABSTOP
