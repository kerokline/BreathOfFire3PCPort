    CONTROL         "", IDC_SP_BLURX, "msctls_trackbar32", TBS_HORZ | TBS_AUTOTICKS | WS_TABSTOP, 106, 66, 150, 14
    LTEXT           "0", IDC_SP_BLURX_V, 260, 69, 30, 9
    LTEXT           "Vertical blur", -1, 14, 85, 90, 9
    CONTROL         "", IDC_SP_BLURY, "msctls_trackbar32", TBS_HORZ | TBS_AUTOTICKS | WS_TABSTOP, 106, 82, 150, 14
    LTEXT           "0", IDC_SP_BLURY_V, 260, 85, 30, 9

    GROUPBOX        "Effects", -1, 7, 108, 286, 108
    AUTOCHECKBOX    "&Natural vision (neutral colours, gamma above)", IDC_SP_NATURAL, 14, 122, 270, 10
    AUTOCHECKBOX    "&Ghosting", IDC_SP_GHOSTING, 14, 136, 130, 10
    AUTOCHECKBOX    "&Chromatic aberration", IDC_SP_CHROMAON, 150, 136, 130, 10
    AUTOCHECKBOX    "&Vignette", IDC_SP_VIGNETTE, 14, 150, 130, 10
    AUTOCHECKBOX    "Vignette shaped for &4:3 only", IDC_SP_VIG43, 150, 150, 136, 10
    AUTOCHECKBOX    "&Interference wiggle", IDC_SP_WIGGLE, 14, 164, 130, 10
    AUTOCHECKBOX    "&Rolling scanlines", IDC_SP_SCANROLL, 150, 164, 130, 10
    AUTOCHECKBOX    "&Overscan crop (trims the picture's edges)", IDC_SP_OVERSCAN, 14, 178, 270, 10
    LTEXT           "On: the side bands of a wide picture stay bright. Off: the vignette covers the full picture.", -1, 26, 209, 260, 9
    LTEXT           "Shadow &mask:", -1, 14, 196, 60, 9
    COMBOBOX        IDC_SP_MASK, 76, 194, 120, 60, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    PUSHBUTTON      "&Defaults", IDC_SP_DEFAULTS, 7, 231, 52, 14
    DEFPUSHBUTTON   "OK", IDOK, 182, 231, 52, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 240, 231, 52, 14
END

// The capture over a Controls cell (DIV-0050): the next key or pad input.
IDD_CAPTURE DIALOGEX 0, 0, 250, 74
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Bind"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "", IDC_CP_PROMPT, 14, 12, 222, 22
    LTEXT           "Escape cancels. Clear removes the binding.", -1, 14, 38, 222, 9
    PUSHBUTTON      "&Clear", IDC_CP_CLEAR, 138, 53, 48, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 194, 53, 48, 14
END

// The music player (docs/music-player.md): a source greyed when the install lacks it; the song
// list owner-drawn, so a stream the source lacks is drawn greyed (section 6).
IDD_MUSIC DIALOGEX 0, 0, 320, 186
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Jukebox"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    GROUPBOX        "Source", -1, 7, 7, 306, 64
    AUTORADIOBUTTON "Play&Station disc", IDC_MP_PSX, 14, 20, 90, 10, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "P&SP disc", IDC_MP_PSP, 110, 20, 90, 10
    AUTORADIOBUTTON "P&C port", IDC_MP_PC, 206, 20, 90, 10
    LTEXT           "", IDC_MP_NOTE, 14, 34, 296, 34

    LTEXT           "S&ong:", -1, 7, 80, 30, 9
    COMBOBOX        IDC_MP_SONG, 40, 78, 273, 200, CBS_DROPDOWNLIST | CBS_OWNERDRAWFIXED | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP | WS_GROUP
    LTEXT           "", IDC_MP_STATUS, 7, 98, 306, 18

    GROUPBOX        "In the game (a sound effect, not a song)", -1, 7, 118, 306, 42
    AUTOCHECKBOX    "&Battle chord: PSP version (one tone)", IDC_MP_CHORD, 14, 130, 290, 10, WS_TABSTOP | WS_GROUP
    LTEXT           "", IDC_MP_CHORD_NOTE, 14, 142, 296, 16

    PUSHBUTTON      "&Play", IDC_MP_PLAY, 7, 165, 52, 14
    PUSHBUTTON      "S&top", IDC_MP_STOP, 63, 165, 52, 14
    DEFPUSHBUTTON   "Close", IDCANCEL, 261, 165, 52, 14
END

// The Sources page (docs/install-sources.md): the player's copies of the game,
// checked and built by tools/importer.py (src/launcher/sources_dialog.cpp).
IDD_SOURCES DIALOGEX 0, 0, 400, 276
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Sources - bof3x"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "", IDC_SO_INTRO, 7, 7, 386, 26
    LTEXT           "Your sources:", -1, 7, 36, 200, 9
    LISTBOX         IDC_SO_LIST, 7, 46, 330, 62, LBS_NOTIFY | LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_HSCROLL | WS_BORDER | WS_TABSTOP
    PUSHBUTTON      "&Remove", IDC_SO_REMOVE, 343, 46, 50, 14

    LTEXT           "&Add a source:", -1, 7, 114, 200, 9
    EDITTEXT        IDC_SO_PATH, 7, 124, 224, 13, ES_AUTOHSCROLL | WS_TABSTOP
    PUSHBUTTON      "&File...", IDC_SO_FILE, 235, 123, 50, 14
    PUSHBUTTON      "F&older...", IDC_SO_FOLDER, 289, 123, 50, 14
    DEFPUSHBUTTON   "A&dd", IDC_SO_ADD, 343, 123, 50, 14

    LTEXT           "", IDC_SO_FFNOTE, 7, 145, 386, 9, SS_PATHELLIPSIS
    PUSHBUTTON      "&Locate ffmpeg.exe...", IDC_SO_FFLOCATE, 231, 157, 76, 14
    PUSHBUTTON      "&Get ffmpeg (website)...", IDC_SO_FFGET, 311, 157, 82, 14

    CONTROL         "", IDC_SO_PROGRESS, "msctls_progress32", WS_BORDER, 7, 180, 386, 9
    LTEXT           "", IDC_SO_STATUS, 7, 192, 386, 9, SS_ENDELLIPSIS
    EDITTEXT        IDC_SO_LOG, 7, 204, 386, 46, ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL | WS_TABSTOP

    LTEXT           "", IDC_SO_HOME, 7, 258, 270, 9, SS_PATHELLIPSIS
    PUSHBUTTON      "&Build the install", IDC_SO_BUILD, 281, 255, 64, 14
    PUSHBUTTON      "&Close", IDCANCEL, 349, 255, 44, 14
END
