#include <windows.h>
#include "launcher/resource.h"

// Common Controls 6 (themed dialog) and per-monitor-unaware DPI scaling, so the
// dialog is neither Windows 95 grey nor bitmap-blurred on a high-DPI desktop.
1 RT_MANIFEST "launcher/launcher.manifest"

IDD_CONFIG DIALOGEX 0, 0, 290, 214
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Breath of Fire III - bof3x"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    GROUPBOX        "Settings", -1, 7, 7, 276, 148

    LTEXT           "&Language:", -1, 16, 24, 62, 9
    COMBOBOX        IDC_LANGUAGE, 84, 22, 186, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "", IDC_LANGNOTE, 84, 37, 186, 9

    LTEXT           "&Texture filter:", -1, 16, 52, 62, 9
    COMBOBOX        IDC_FILTER, 84, 50, 186, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    LTEXT           "&Display:", -1, 16, 70, 62, 9
    COMBOBOX        IDC_DISPLAY, 84, 68, 186, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    LTEXT           "&Resolution:", -1, 16, 88, 62, 9
    COMBOBOX        IDC_RESOLUTION, 84, 86, 186, 80,
                    CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP | WS_DISABLED
    LTEXT           "Fixed at 640x480 for now - see docs/IDEAS.md I8.", -1, 84, 101, 196, 9

    LTEXT           "Re&nderer:", -1, 16, 118, 62, 9
    COMBOBOX        IDC_RENDERER, 84, 116, 186, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Which mode is which is not established; change only to test.",
                    -1, 84, 131, 186, 9

    AUTOCHECKBOX    "&Show this window every time", IDC_SHOW, 14, 162, 200, 10
    LTEXT           "Unticked, the game starts straight away. Run bof3x-launcher --config to bring it back.",
                    -1, 14, 175, 262, 9

    DEFPUSHBUTTON   "&Play", IDOK, 172, 193, 52, 14
    PUSHBUTTON      "E&xit", IDCANCEL, 230, 193, 52, 14
END
