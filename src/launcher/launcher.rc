    PUSHBUTTON      "", 1302, 49, 61, 56, 14
    PUSHBUTTON      "", 1322, 108, 61, 56, 14
    PUSHBUTTON      "", 1342, 170, 61, 84, 14
    PUSHBUTTON      "", 1362, 257, 61, 84, 14
    LTEXT           "Right", -1, 7, 80, 40, 9
