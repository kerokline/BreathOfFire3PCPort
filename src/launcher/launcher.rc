    PUSHBUTTON      "", 1323, 108, 78, 56, 14
    PUSHBUTTON      "", 1343, 170, 78, 84, 14
    PUSHBUTTON      "", 1363, 257, 78, 84, 14
    LTEXT           "Cross", -1, 7, 97, 40, 9
    PUSHBUTTON      "", 1304, 49, 95, 56, 14
    PUSHBUTTON      "", 1324, 108, 95, 56, 14
    PUSHBUTTON      "", 1344, 170, 95, 84, 14
    PUSHBUTTON      "", 1364, 257, 95, 84, 14
    LTEXT           "Circle", -1, 7, 114, 40, 9
    PUSHBUTTON      "", 1305, 49, 112, 56, 14
    PUSHBUTTON      "", 1325, 108, 112, 56, 14
    PUSHBUTTON      "", 1345, 170, 112, 84, 14
    PUSHBUTTON      "", 1365, 257, 112, 84, 14
