// Generated by CMake from src/version.h.in: the version every binary carries
// in its VS_VERSIONINFO resource (src/version.rc; bof3x.exe's is written by
// tools/make_exe.py from the same numbers). The numbers are CMakeLists.txt's
// project(VERSION); the tag is BOF3X_VERSION_TAG, which the release workflow
// sets to the git tag (v0.1.0-alpha.2) or to latest-<sha> for a push to main,
// and which defaults to v<numbers> for a local build.
#pragma once
#define BOF3X_VERSION_MAJOR @PROJECT_VERSION_MAJOR@
#define BOF3X_VERSION_MINOR @PROJECT_VERSION_MINOR@
#define BOF3X_VERSION_PATCH @PROJECT_VERSION_PATCH@
#define BOF3X_VERSION_STR "@PROJECT_VERSION@"
#define BOF3X_VERSION_TAG "@BOF3X_VERSION_TAG@"
